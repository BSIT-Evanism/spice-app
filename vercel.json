{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && bun install",
      "buildCommand": "NEXT_PUBLIC_SERVER_URL=/api bun run build",
      "bindings": [
        {
          "type": "service",
          "service": "server",
          "format": "url",
          "env": "SERVER_URL"
        }
      ]
    },
    "server": {
      "root": "apps/server",
      "framework": "elysia",
      "entrypoint": "src/index.ts",
      "installCommand": "cd ../.. && bun install",
      "buildCommand": "bun run env:generate && bun run check-types",
      "functions": {
        "src/index.ts": {
          "includeFiles": "{package.json,apps/server/.env.schema,node_modules/.bin/varlock,node_modules/varlock/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
